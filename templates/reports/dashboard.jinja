{% extends "base.jinja" %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary">📊 Library Analytics Dashboard</h2>
    <div>
        <a href="/reports/export/csv/" class="btn btn-outline-success me-2">
            📥 Export CSV
        </a>
        <a href="/library/books/" class="btn btn-primary">
            📚 View Catalog
        </a>
    </div>
</div>

<!-- KPI Cards Row -->
<div class="row g-3 mb-4">
    <!-- Total Books -->
    <div class="col-md-3">
        <div class="card border-primary h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-book fs-1 text-primary"></i>
                <h5 class="card-title mt-2">Total Books</h5>
                <h2 class="display-4 fw-bold text-primary">{{ stats.total_books|default(0) }}</h2>
                <p class="text-muted small">In catalog</p>
            </div>
        </div>
    </div>
    
    <!-- Active Members -->
    <div class="col-md-3">
        <div class="card border-success h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-people fs-1 text-success"></i>
                <h5 class="card-title mt-2">Active Members</h5>
                <h2 class="display-4 fw-bold text-success">{{ stats.total_members|default(0) }}</h2>
                <p class="text-muted small">Registered users</p>
            </div>
        </div>
    </div>
    
    <!-- Issued Today -->
    <div class="col-md-3">
        <div class="card border-info h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-arrow-right-circle fs-1 text-info"></i>
                <h5 class="card-title mt-2">Issued Today</h5>
                <h2 class="display-4 fw-bold text-info">{{ stats.issued_today|default(0) }}</h2>
                <p class="text-muted small">Books lent out</p>
            </div>
        </div>
    </div>
    
    <!-- Overdue Books -->
    <div class="col-md-3">
        <div class="card border-warning h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-exclamation-triangle fs-1 text-warning"></i>
                <h5 class="card-title mt-2">Overdue</h5>
                <h2 class="display-4 fw-bold text-warning">{{ stats.overdue|default(0) }}</h2>
                <p class="text-muted small">Pending returns</p>
            </div>
        </div>
    </div>
</div>

<!-- Fines Summary Card -->
<div class="card border-danger mb-4 shadow-sm">
    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">💰 Fines Collection</h5>
        <span class="badge bg-light text-danger fs-6">
            ₹{{ "%.2f"|format(stats.fines_collected|default(0)) }}
        </span>
    </div>
    <div class="card-body">
        <div class="progress" style="height: 25px;">
            <div class="progress-bar bg-danger" role="progressbar" 
                 style="width: {{ ((stats.fines_collected|default(0) / 1000 * 100)|int if (stats.fines_collected|default(0) / 1000 * 100)|int <= 100 else 100) }}%" 
                 aria-valuenow="{{ stats.fines_collected|default(0) }}" 
                 aria-valuemin="0" aria-valuemax="1000">
                ₹{{ "%.2f"|format(stats.fines_collected|default(0)) }} collected
            </div>
        </div>
        <small class="text-muted">Target: ₹1,000/month • Rate: ₹5/day overdue</small>
    </div>
</div>

<!-- Quick Actions Panel -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">⚡ Quick Actions</h5>
    </div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <a href="/transactions/issue/" class="btn btn-outline-primary w-100 py-3">
                    <i class="bi bi-bookmark-plus"></i><br>Issue Book
                </a>
            </div>
            <div class="col-md-3">
                <a href="/transactions/return/" class="btn btn-outline-success w-100 py-3">
                    <i class="bi bi-arrow-return-left"></i><br>Process Return
                </a>
            </div>
            <div class="col-md-3">
                <a href="/library/books/?q=" class="btn btn-outline-info w-100 py-3">
                    <i class="bi bi-search"></i><br>Search Catalog
                </a>
            </div>
            <div class="col-md-3">
                <a href="/admin/" class="btn btn-outline-secondary w-100 py-3">
                    <i class="bi bi-gear"></i><br>Admin Panel
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity Placeholder -->
<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">🕐 Recent Activity</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> 
            <strong>Activity logging module</strong> will display recent transactions here. 
            <a href="/admin/transactions/bookissue/" class="alert-link">View in Admin</a>
        </div>
    </div>
</div>
{% endblock %}